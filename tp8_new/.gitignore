# ThinkPHP 8.0 项目 Git 忽略文件

# 系统文件
.DS_Store
Thumbs.db

# 环境配置
.env

# 运行时目录
storage/cache/*
storage/log/*
storage/runtime/*
storage/template/*
!storage/cache/.gitkeep
!storage/log/.gitkeep
!storage/runtime/.gitkeep
!storage/template/.gitkeep

# Composer 依赖
vendor/

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~

# 测试文件
phpunit.xml
tests/

# 文档生成
docs/
