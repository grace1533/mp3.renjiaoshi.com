APP_DEBUG = true
APP_URL = http://localhost

# 数据库配置
DB_TYPE = mysql
DB_HOSTNAME = 127.0.0.1
DB_DATABASE = jymusic
DB_USERNAME = root
DB_PASSWORD = 
DB_HOSTPORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX = jy_

# 缓存配置
CACHE_DRIVER = file

# Session 配置
SESSION_DRIVER = file

# 日志配置
LOG_CHANNEL = file
LOG_LEVEL = error,sql
